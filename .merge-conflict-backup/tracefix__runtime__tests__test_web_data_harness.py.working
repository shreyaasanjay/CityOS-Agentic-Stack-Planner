def test_web_data_harness_lists_takes_when_date_has_single_recording(tmp_path):
    manifest = _make_manifest(tmp_path)
    server, url = _start_server(_SmartroomHandler)
    try:
        result = run_web_data_apps(
            manifest_path=manifest,
